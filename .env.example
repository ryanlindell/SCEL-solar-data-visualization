# Copy this file to ".env" and put your own key after the equals sign.
# Get a free key at https://www.eia.gov/opendata/ (no quotes, no spaces).
EIA_API_KEY=your_key_here

# Tier 2 (duck curve) also needs a free NREL key: https://developer.nlr.gov/signup/
NREL_API_KEY=your_key_here

# The NSRDB 2012 Mānoa line (python -m nsrdb_model.run) also needs the email NREL should associate with requests.
NSRDB_EMAIL=you@example.com
